DATABASE_URL=
SECRET_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=8000

# EnviStats database (relative to backend folder)
ENVI_STATS_DATABASE_PATH=data/envi_stats_chroma_db

# Scheduler and ingestion
INGEST_ENABLED=true
INGEST_TIMEZONE=Asia/Kolkata
INGEST_HOUR_IST=6
INGEST_MINUTE_IST=0

# CORS: add your frontend origin when deploying
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Google Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# HTTP integration settings
INTEGRATION_TIMEOUT_SECONDS=15
INTEGRATION_MAX_RETRIES=2
